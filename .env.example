# Copy to .env for local development. In production these are set as
# Vercel project env vars (backend) / GitHub Secrets (pipeline, see workflows).

GITHUB_REPO=ausim99/ai-tech-news-assistant
GITHUB_TOKEN=
GITHUB_BRANCH=main
ALLOWED_ORIGINS=*

# Only needed to run the pipeline itself locally (scripts/run_pipeline.py,
# healthcheck.py) - the FastAPI backend above doesn't use these.
GROK_API_KEY=
GROK_MODEL=grok-4
# Fallback providers, tried in order if Grok fails (both optional).
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_TO_ADDRESS=
